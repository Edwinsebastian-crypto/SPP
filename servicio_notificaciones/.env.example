# ===== Servicio =====
PORT=4000
TZ=America/Bogota

# ===== Seguridad entre servicios =====
# Mismo valor que NOTIFICATION_SERVICE_SECRET en el .env del monolito (mínimo 16 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NOTIFICATION_SERVICE_SECRET=

# ===== MongoDB (base propia del microservicio; colección `notificaciones`) =====
# Con docker compose se levanta un MongoDB local y la URI se arma sola con estas tres variables:
MONGO_USER=spp
MONGO_PASSWORD=cambia_esta_clave
MONGO_DB=spp_notificaciones
# Para usar MongoDB Atlas (o cualquier otro) descomenta y pon tu URI; reemplaza al MongoDB del compose.
# Fuera de Docker (npm start) esta variable es obligatoria, p. ej. mongodb://spp:clave@localhost:27017/spp_notificaciones?authSource=admin
# MONGO_URI_NOTIFICATIONS=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/spp_notificaciones?appName=Cluster0

# ===== Comunicación con microservicios (HTTP) =====
# URL del monolito SOFTWARE_SPP para consultar prácticas, actividades y usuarios (sin tocar su BD)
MONOLITH_URL=http://localhost:3000
# Opcional: URL del servicio de evaluación (FastAPI) para consultar evaluaciones e intentos
EVALUATION_SERVICE_URL=http://localhost:8000
EVALUATION_SERVICE_SECRET=

# ===== Correo =====
# smtp = envía de verdad (con Docker, por defecto, a Mailpit: http://localhost:8025)
# log  = no envía: imprime en consola y marca la notificación como enviada (para probar sin SMTP)
MAIL_MODE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true solo para el puerto 465
# SMTP_USER=notificaciones@udi.edu.co
# SMTP_PASS=
MAIL_FROM="SPP Prácticas Pedagógicas <no-reply@udi.edu.co>"
# Botón «Ir al SPP» de los correos
APP_URL=http://localhost:3000

# ===== Opcionales =====
# JOBS_ENABLED=true          # false = no ejecuta recordatorios ni resúmenes (solo eventos)
# JOBS_INTERVAL_MS=900000    # cada cuánto revisa pendientes (15 min)
# REMINDER_HOURS=24          # con cuánta anticipación avisa de una entrega
# DIGEST_HOUR=7              # hora local desde la que se envía el resumen diario a tutor/asesor/director
# DISPATCH_INTERVAL_MS=10000 # cada cuánto revisa la cola para enviar
# MAX_ATTEMPTS=5             # reintentos antes de marcar «Fallida»
# LEGACY_QUEUE=false         # true = también envía los documentos antiguos que escribía el monolito (sin estadoEnvio). Por defecto se ignoran
