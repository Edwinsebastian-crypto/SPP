# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - SPP (ORACLE CLOUD + DOCKER COMPOSE)
# ==============================================================================
# Guarda este archivo como .env en el servidor (en la raíz del repo clonado):
# cp .env.production.example .env
# chmod 600 .env
# ==============================================================================

# --- DOMINIO PÚBLICO (DuckDNS o propio) ---
# Ej: spp-proyecto.duckdns.org (o subdominio propio)
DOMAIN=spp.midominio.com

# --- SECRETOS INTERNOS ENTRE SERVICIOS ---
# Generar dos secretos largos y diferentes (ej. en terminal: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
S_EVAL=CAMBIAR_POR_TOKEN_ALEATORIO_48_BYTES_EVALUACION
S_NOTIF=CAMBIAR_POR_TOKEN_ALEATORIO_48_BYTES_NOTIFICACIONES

# --- BASES DE DATOS (Neon PostgreSQL y MongoDB Atlas) ---
# Base de datos de Prácticas en Neon:
DATABASE_URL_PRACTICE=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/spp_practicas?sslmode=require

# Base de datos de Evaluación en Neon:
# (Se normaliza automáticamente a postgresql+psycopg:// si viene con postgresql://)
DATABASE_URL_EVALUACION=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/spp_evaluacion?sslmode=require

# Base de datos primaria MongoDB Atlas (opcional, para auditoría e indicadores):
MONGO_URI_PRIMARY=mongodb+srv://usuario:password@cluster.mongodb.net/spp_primaria?retryWrites=true&w=majority

# Base de datos de Notificaciones MongoDB Atlas:
MONGO_URI_NOTIFICATIONS=mongodb+srv://usuario:password@cluster.mongodb.net/spp_notificaciones?retryWrites=true&w=majority

# --- SUPABASE (Autenticación del monolito) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --- CONFIGURACIÓN INSTITUCIONAL Y MEDIA ---
INSTITUTIONAL_DOMAIN=udi.edu.co
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- INTELIGENCIA ARTIFICIAL (Servicio de Evaluación) ---
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=tu_google_gemini_api_key
LLM_MODEL=gemini-2.5-flash
# O si usas Claude:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=tu_anthropic_api_key

# --- ENVÍO DE CORREO SMTP (Servicio de Notificaciones) ---
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@udi.edu.co
SMTP_PASS=tu_app_password_de_google
MAIL_FROM="SPP Notificaciones <no-reply@udi.edu.co>"
